  rw [shape,List.length_append,List.length_append,pl] at total
  have how : ss.length=2 := by simp only [List.length_cons,List.length_nil] at total;omega
  cases h5 : ss with
  | nil => simp [h5] at how
  | cons u5 rest5 =>
    cases h6 : rest5 with
    | nil => simp [h5,h6] at how
